(include "./right.yuck")
(include "./left.yuck")
(include "./workspaces.yuck")
(include "./kepi.yuck")

(defwidget bar []
  (centerbox 
    ; :class "bar"
    (left) (center) (right)))

(defpoll timeleft :interval "1s"
  `upower -i $(upower -e | grep BAT) | grep --color=never -E "to full|to empty" | cut -d':' -f2- | sed 's/^[[:space:]]*//'`)

(defwidget center []
  (box
    :even-spacing false
    :spacing 0
    (workspaces)
  )
)

(defwindow bar
  :exclusive true
  :monitor 0
  :windowtype "normal"
  :geometry (geometry :x "0%"
                      :y "1%"
					  :width "98.8%"
					  :height "2%"
					  :anchor "top center")
  :stacking "bg"
  :reserve (struts :side "top" :distance "2%")
  (bar))
