(defwidget bar []
  (centerbox (left) (center) (right)))

(defwidget left [] 
  datetime)

(defwidget center [] (literal :class "rcorners" :y "7%" "${EWW_BATTERY.BAT0.capacity}"))

(defvar revealcalendar false)
(defwidget right [] 
  (box
    (expander 
        :expanded revealcalendar
        (box :class "rcorners" (calendar)))
    (literal :class "rcorners" "hello")))


(defpoll datetime :interval "1s"
  `date "+%B %e %a %H:%M:%S %Y"`)

(defpoll gpuusage :interval "1s"
  `gpustat --no-color | cut -d '|' -f2 | cut -b "9,10,11" | sed -e "1d" | sed -e "s/ //"`)

(defwindow bar
  :exclusive true
  :monitor 0
  :windowtype "normal"
  :geometry (geometry :x "0%"
                      :y "1%"
					  :width "97%"
					  :height "4%"
					  :anchor "top center")
  :stacking "fg"
  :reserve (struts :side "top" :distance "2%")
  (bar))
