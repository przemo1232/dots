(defpoll datetime :interval "1s"
  `date "+%B %e %a %H:%M:%S %Y"`)

(defpoll gpuusage :interval "1s"
  `gpustat --no-color | cut -d '|' -f2 | cut -b "9,10,11" | sed -e "1d" | sed -e "s/ //"`)

(defwidget bar []
  (centerbox (left) (center) (right)))

(defpoll workspace-json :interval "5s"
  `hyprctl workspaces -j`)

(defwidget workspace [number]
  (button 
    :class "workspace-button"
    :onclick "hyprctl dispatch workspace ${number}"
    :tooltip "${(jq(workspace-json, ".[] | select(.id == " + number + ")") ?: "") == "" ? "No Monitor" : "Monitor " + jq(workspace-json, ".[] | select(.id == " + number + ")").monitorID}${(jq(workspace-json, ".[] | select(.id == " + number + ")") ?: "") == "" ? "" : " | " + (jq(workspace-json, ".[] | select(.id == " + number + ")").lastwindowtitle)}"
    (literal :content number :class "monitor-${(jq(workspace-json, ".[] | select(.id == " + number + ")") ?: "") == "" ? "none" : jq(workspace-json, ".[] | select(.id == " + number + ")").monitorID}")
  )
)

(defwidget workspaces []
  (box :class "rcorners"
    (workspace :number "1")
    (workspace :number "2")
    (workspace :number "3")
    (workspace :number "4")
    (workspace :number "5")
    (workspace :number "6")
    (workspace :number "7")
    (workspace :number "8")
    (workspace :number "9")
    (workspace :number "10")
  )
)

(defpoll song-title :interval "1s"
  `spotifycli --song`)

(defpoll artist :interval "1s"
  `spotifycli --artist`)

(defpoll position :interval "0.25s"
  `spotifycli --position`)
  
(defpoll positionraw1 :interval "0.25s"
  `spotifycli --position | sed 's/[()]//g' | awk -F '/' '{print $1}'`)
  
(defpoll positionraw2 :interval "0.25s"
  `spotifycli --position | sed 's/[()]//g' | awk -F '/' '{print $2}'`)

(defpoll playstatus :interval "0.1s"
  `spotifycli --playbackstatus`)

(defwidget spotify []
  (box 
    :spacing 5
    :space-evenly false
    :class "rcorners"
    :visible "${positionraw1 == "" ? "false" : "true"}"
    (button :onclick "spotifycli --playpause" (literal "${playstatus}"))
    (literal "${song-title} - ${artist} | ${positionraw1} / ${positionraw2}")
))

(defwidget left [] 
  (box
    :halign "start"
    (literal :class "rcorners" "${datetime}")
    (workspaces)
    (spotify)
))

(defpoll timeleft :interval "1s"
  `upower -i $(upower -e | grep BAT) | grep --color=never -E "to full|to empty" | cut -d':' -f2- | sed 's/^[[:space:]]*//'`)

(defwidget center []
  (box 
    :class "rcorners"
    :visible "${(EWW_BATTERY ?: "") != "" ? "true" : "false"}"
    (literal "${(EWW_BATTERY ?: "") != "" ? (EWW_BATTERY.BAT0.status == "Charging" ? "⚡" : "") : ""} ${(EWW_BATTERY ?: "") != "" ? EWW_BATTERY.BAT0.capacity + "% " : ""}${timeleft}")))

(defpoll volume :interval "0.1s"
  `wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2}'`)

(defpoll muted :interval "0.1s"
  `wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $3}'`)

(defwidget right [] 
  (box 
    :halign "end"
    (literal :class "rcorners" "🐑 ${round(EWW_RAM.used_mem / EWW_RAM.total_mem * 100, 2)}% 🔳 ${round(EWW_CPU.avg, 2)}% ↑ ${(EWW_NET.wlp6s0 ?: EWW_NET.enp42s0).NET_UP > 1000000 ? round((EWW_NET.wlp6s0 ?: EWW_NET.enp42s0).NET_UP / 1000000, 2) + " mb/s" : ((EWW_NET.wlp6s0 ?: EWW_NET.enp42s0).NET_UP > 1000 ? round((EWW_NET.wlp6s0 ?: EWW_NET.enp42s0).NET_UP / 1000, 2) + " kb/s" : round((EWW_NET.wlp6s0 ?: EWW_NET.enp42s0).NET_UP, 2) + " b/s")} ↓ ${(EWW_NET.wlp6s0 ?: EWW_NET.enp42s0).NET_DOWN > 1000000 ? round((EWW_NET.wlp6s0 ?: EWW_NET.enp42s0).NET_DOWN / 1000000, 2) + " mb/s" : ((EWW_NET.wlp6s0 ?: EWW_NET.enp42s0).NET_DOWN > 1000 ? round((EWW_NET.wlp6s0 ?: EWW_NET.enp42s0).NET_DOWN / 1000, 2) + " kb/s" : round((EWW_NET.wlp6s0 ?: EWW_NET.enp42s0).NET_DOWN, 2) + " b/s")} ${muted != "[MUTED]" ? (volume > 0.5 ? "🔊" : (volume < 0.20 ? "🔈" : "🔉")) : "🔇"} ${round(volume * 100, 2)}% 💾 Home: ${round(EWW_DISK["/home"].used_perc, 2)}% 💾 Nix: ${round(EWW_DISK["/nix"].used_perc, 2)}%${(EWW_DISK["/run/media/Gaming"] ?: "") == "" ? "" : " 💾 Gaming: " + round(EWW_DISK["/run/media/Gaming"].used_perc, 2) + "%"}")))

(defwindow bar
  :exclusive true
  :monitor 0
  :windowtype "normal"
  :geometry (geometry :x "0%"
                      :y "1%"
					  :width "97%"
					  :height "2%"
					  :anchor "top center")
  :stacking "fg"
  :reserve (struts :side "top" :distance "2%")
  (bar))
