(include "./enable-disable-right.yuck")
(include "./audio-devices.yuck")

(defpoll gpuusage :interval "1s"
  `gpustat --no-color | cut -d '|' -f2 | cut -b "9,10,11" | sed -e "1d" | sed -e "s/ //"`)

(defpoll volume :interval "0.1s"
  `wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2}'`)

(defpoll muted :interval "0.1s"
  `wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $3}'`)

; (defwidget ascii-bar [amount]
;   (if { number }):wq
; )

(defwidget internet [net]
  (literal "${(net ?: "") != "" ? (net > 1000000 ? round(net / 1000000, 2) + " mb/s" : (net > 1000 ? round(net / 1000, 2) + " kb/s" : net + " b/s")) : ""}")
)

(defvar network-revealed false)

(defwidget network [?visible ?visible-emoji ?labels-visible]
  (box
    :visible { visible ?: true }
    :spacing 0
    :space-evenly false
    (simple-revealer
      :visible { visible ?: true }
      :class "rcorners"
      :variable { network-revealed }
      :var-name "network-revealed"
      (literal 
        :visible { visible-emoji }
        "↑")
      (box
        :space-evenly false
        (literal
          :visible { labels-visible }
          "UP: ")
        (box
          :spacing 5
          :space-evenly false
          (internet
            :net "${EWW_NET?.enp42s0?.NET_UP}")
          (internet
            :net "${EWW_NET?.wlp6s0?.NET_UP}")
        )
      )
    )
    (simple-revealer
      :visible { visible ?: true }
      :class "rcorners"
      :variable { network-revealed }
      :var-name "network-revealed"
      (literal 
        :visible { visible-emoji }
        "↓")
      (box
        :space-evenly false
        (literal
          :visible { labels-visible }
          "DOWN: ")
        (box
          :spacing 5
          :space-evenly false
          (internet
            :net "${EWW_NET?.enp42s0?.NET_DOWN}")
          (internet
            :net "${EWW_NET?.wlp6s0?.NET_DOWN}")
        )
      )
    )
  )
)

(defvar ram-revealed false)

(defwidget ram [?visible ?visible-emoji ?labels-visible]
  (simple-revealer
    :visible { visible ?: true }
    :class "rcorners"
    :variable { ram-revealed }
    :var-name "ram-revealed"
    (literal "${visible-emoji ? "🐑" : ""}")
    (literal 
      :visible { visible ?: true }
      "${labels-visible ? "RAM: " : ""}${round(EWW_RAM.used_mem / EWW_RAM.total_mem * 100, 2)}%")
  )
)

(defvar cpu-revealed false)

(defwidget cpu [?visible ?visible-emoji ?labels-visible]
  (simple-revealer
    :visible { visible ?: true }
    :class "rcorners"
    :variable { cpu-revealed }
    :var-name "cpu-revealed"
    (literal "${visible-emoji ? "🔳" : ""}")
    (literal 
      :visible { visible ?: true }
      "${labels-visible ? "CPU: " : ""}${round(EWW_CPU.avg, 2)}%")
  )
)

(defvar audio-revealed false)

(defwidget audio [?visible ?visible-emoji ?labels-visible]
  (simple-revealer
    :visible { visible ?: true }
    :class "rcorners"
    :variable { audio-revealed }
    :var-name "audio-revealed"
    (literal "${visible-emoji ? (muted != "[MUTED]" ? (volume > 0.5 ? "🔊" : (volume < 0.20 ? "🔈" : "🔉")) : "🔇") : ""}")
    (button
      :onclick `${EWW_EXECUTABLE} open audio-devices --toggle`
      "${labels-visible ? "AUDIO: " : ""}${round(volume * 100, 2)}%")
  )
)

(defvar disk-revealed false)

(defwidget disk [?visible ?visible-emoji ?labels-visible disk-name mount-point]
  (simple-revealer
    :visible { (visible ?: true) && ((EWW_DISK[mount-point] ?: "") != "") }
    :class "rcorners"
    :variable { disk-revealed }
    :var-name "disk-revealed"
    (literal "${(visible-emoji ? "💾" : "")}")
    (literal 
      "${(EWW_DISK[mount-point] ?: "") != "" ? (labels-visible ? disk-name + ": " : "") + round(EWW_DISK[mount-point].used_perc, 2) + "%" : ""}")
  )
)

(defwidget simple-revealer [var-name variable ?class ?visible]
  (eventbox
    :visible { visible ?: true }
    :class "${class} simple-revealer"
    :onhover "${EWW_EXECUTABLE} update ${var-name}=true"
    :onhoverlost "${EWW_EXECUTABLE} update ${var-name}=false"
    (box
      :space-evenly false
      :spacing { variable ? 5 : 0 }
      :class "simple-revealer"
      (children :nth 0)
      (revealer
        :transition "slideleft"
        :reveal { variable }
        (children :nth 1)
      )
    )
  )
)

; this shit kinda annoying but it's the sacrifice I have to make :drooling:
(defvar ram-visible true)
(defvar cpu-visible true)
(defvar network-visible true)
(defvar audio-visible true)
(defvar disk-visible true)
(defvar ram-visible-emoji true)
(defvar cpu-visible-emoji true)
(defvar network-visible-emoji true)
(defvar audio-visible-emoji true)
(defvar disk-visible-emoji true)
(defvar ram-visible-labels false)
(defvar cpu-visible-labels false)
(defvar network-visible-labels false)
(defvar audio-visible-labels false)
(defvar disk-visible-labels true)

(defwidget right [] 
  (box 
    :space-evenly false
    :spacing 0
    :halign "end"
    (ram
      :visible { ram-visible }
      :visible-emoji { ram-visible-emoji }
      :labels-visible { ram-visible-labels }
    )
    (cpu
      :visible { cpu-visible }
      :visible-emoji { cpu-visible-emoji }
      :labels-visible { cpu-visible-labels }
    )
    (network
      :visible { network-visible }
      :visible-emoji { network-visible-emoji }
      :labels-visible { network-visible-labels }
    )
    (audio
      :visible { audio-visible }
      :visible-emoji { audio-visible-emoji }
      :labels-visible { audio-visible-labels }
    )
    (disk 
      :visible { disk-visible }
      :visible-emoji { disk-visible-emoji }
      :labels-visible { disk-visible-labels }
      :disk-name "Home"
      :mount-point "/home")
    (disk 
      :visible { disk-visible }
      :visible-emoji { disk-visible-emoji }
      :labels-visible { disk-visible-labels }
      :disk-name "Nix"
      :mount-point "/nix")
    (disk 
      :visible { disk-visible }
      :visible-emoji { disk-visible-emoji }
      :labels-visible { disk-visible-labels }
      :disk-name "Gaming"
      :mount-point "/run/media/Gaming")
    (toggle-items)
  )
)
