(defwindow toggle-items
  :monitor 0
  :exclusive false
  :stacking "overlay"
  :geometry (geometry
    :anchor "top right"
    :x "0.60%"
    :y 10
  )
  (toggle-items-window)
)

(defwidget toggle-items []
  (button
    :onclick "${EWW_EXECUTABLE} open toggle-items --toggle"
    (literal :class "rcorners" "✧̣̇˚.")
  )
)

(defwidget right-item [item-name name variable emoji-variable ?labels-variable]
  (box
    :space-evenly false
    :orientation "vertical"
    (button
      :class "rcorners"
      :onclick "${EWW_EXECUTABLE} update ${name}=${!variable}"
      (literal "${variable ? "Y" : "N"} ❥ ${item-name}")
    )
    (button
      :class "rcorners"
      :onclick "${EWW_EXECUTABLE} update ${name}-emoji=${!emoji-variable}"
      (literal "${emoji-variable ? "Y" : "N"} ❥ EMOJI")
    )
    (button
      :class "rcorners"
      :onclick "${EWW_EXECUTABLE} update ${name}-labels=${!labels-variable}"
      (literal "${labels-variable ? "Y" : "N"} ❥ LABELS")
    )
  )
)

(defwidget toggle-items-window []
  (box
    :space-evenly true
    :spacing 0
    :class "bar"
    (right-item
      :item-name "RAM"
      :name "ram-visible"
      :variable { ram-visible }
      :emoji-variable { ram-visible-emoji }
      :labels-variable { ram-visible-labels }
    )
    (right-item
      :item-name "CPU"
      :name "cpu-visible"
      :variable { cpu-visible }
      :emoji-variable { cpu-visible-emoji }
      :labels-variable { cpu-visible-labels }
    )
    (right-item
      :item-name "NETWORK"
      :name "network-visible"
      :variable { network-visible }
      :emoji-variable { network-visible-emoji }
      :labels-variable { network-visible-labels }
    )
    (right-item
      :item-name "AUDIO"
      :name "audio-visible"
      :variable { audio-visible }
      :emoji-variable { audio-visible-emoji }
      :labels-variable { audio-visible-labels }
    )
    (right-item
      :item-name "DISK"
      :name "disk-visible"
      :variable { disk-visible }
      :emoji-variable { disk-visible-emoji }
      :labels-variable { disk-visible-labels }
    )
  )
)
