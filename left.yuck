(include "./simple-revealer.yuck")

(defpoll song-title :interval "1s"
  `spotifycli --song`)

(defpoll album :interval "1s"
  `spotifycli --album`)

(defpoll artist :interval "0.5s"
  `spotifycli --artist`)

(defpoll position :interval "0.25s"
  `spotifycli --position`)
  
(defpoll positionraw1 :interval "0.25s"
  `spotifycli --position | sed 's/[()]//g' | awk -F '/' '{print $1}'`)
  
(defpoll positionraw2 :interval "0.25s"
  `spotifycli --position | sed 's/[()]//g' | awk -F '/' '{print $2}'`)

(defpoll playstatus :interval "0.1s"
  `spotifycli --playbackstatus`)

(defwidget player []
  (box
    :space-evenly false
    :spacing 0
    (button :onclick "spotifycli --prev" (literal "⏮"))
    (button :onclick "spotifycli --playpause" (literal "${playstatus == "▮▮" ? "⏵" : "⏸"}"))
    (button :onclick "spotifycli --next" (literal "⏭"))
  )
)

(defvar spotify-revealed false)

(defwidget spotify []
  (simple-revealer
    :visible "${positionraw1 == "" ? "false" : "true"}"
    :class "rcorners"
    :variable { spotify-revealed }
    :var-name "spotify-revealed"
    :transition "slideright"
    (player)
    (literal " | ${song-title}${song-title != album ? " ∈ " + album : ""} - ${artist} | ${positionraw1} / ${positionraw2}")
  )
)

(defpoll datetime :interval "1s"
  `date "+%B %e %a %H:%M:%S %Y"`)

(defwidget left [] 
  (box
    :spacing 0
    :space-evenly false
    :halign "start"
    (eventbox
      :onhover "${EWW_EXECUTABLE} open kepi --toggle"
      :onhoverlost "${EWW_EXECUTABLE} open kepi --toggle"
      (literal 
        :class "rcorners"
        "${datetime}"))
    (literal 
      :class "rcorners"
      :visible "${(EWW_BATTERY ?: "") != "" ? "true" : "false"}"
      "${(EWW_BATTERY ?: "") != "" ? (EWW_BATTERY.BAT0.status == "Charging" ? "⚡" : "") : ""} ${(EWW_BATTERY ?: "") != "" ? EWW_BATTERY.BAT0.capacity + "% " : ""}${timeleft}"
    )
    (spotify)
  )
)
